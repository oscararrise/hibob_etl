HIBOB_BASE_URL=https://api.hibob.com/v1

HIBOB_CREDENTIAL_NAMES=default
HIBOB_SERVICE_USER_ID=replace_me
HIBOB_SERVICE_USER_TOKEN=replace_me

# Example for several credentials:
# HIBOB_CREDENTIAL_NAMES=ta,hr,finance
# HIBOB_TA_SERVICE_USER_ID=replace_me
# HIBOB_TA_SERVICE_USER_TOKEN=replace_me
# HIBOB_HR_SERVICE_USER_ID=replace_me
# HIBOB_HR_SERVICE_USER_TOKEN=replace_me
# HIBOB_FINANCE_SERVICE_USER_ID=replace_me
# HIBOB_FINANCE_SERVICE_USER_TOKEN=replace_me

OUTPUT_FILE=output/hibob_employees.xlsx
RAW_JSON_FILE=output/hibob_employees_raw.json
FIELDS_PER_REQUEST=100
SHOW_INACTIVE=true
HUMAN_READABLE=APPEND
REQUEST_TIMEOUT=300
SECONDS_BETWEEN_REQUESTS=2

# Optional target employee sheet
TARGET_EMAIL=
TARGET_EMPLOYEE_ID=
